rules_version = '2';
service cloud.firestore {
 match /databases/{db}/documents {
  function sig(){return request.auth!=null}
  function U(){return /databases/$(db)/documents/users/$(request.auth.uid)}
  function has(){return sig() && exists(U())}
  function role(){return get(U()).data.role}
  function canEdit(){return has() && role() in ['editor','admin']}
  function isAdmin(){return has() && role()=='admin'}
  function s(d,k,n){return !(k in d) || (d[k] is string && d[k].size()<=n)}
  function okPh(d){return !('photo' in d) || (d.photo is string && d.photo.size()<100000 && d.photo.matches('data:image/jpeg;base64,.*'))}
  function okRec(d){return d.keys().hasOnly(['personName','statusType','beneficiary','relation','unified','district','birthDate','attendanceDate','benKey','photo','hf','hb','by','createdAt','updatedAt','pct','bc','sk','ld','att'])
    && d.personName is string && d.personName.size()>0 && d.personName.size()<=120
    && d.statusType in ['شهيد','شهيدة','مصاب','مصابه']
    && s(d,'beneficiary',120) && s(d,'relation',40) && s(d,'unified',30) && s(d,'district',40) && s(d,'birthDate',12) && s(d,'attendanceDate',12) && s(d,'benKey',140) && okPh(d)
    && (!('pct' in d) || (d.pct is int && d.pct>=30 && d.pct<=100))
    && (!('bc' in d) || (d.bc is int && d.bc>=0))
    && (!('sk' in d) || (d.sk is list && d.sk.size()<=400)) && s(d,'ld',12) && (!('att' in d) || (d.att is list && d.att.size()<=500))}
  function okBen(d){return d.keys().hasOnly(['rid','beneficiary','relation','unified','district','birthDate','attendanceDate','benKey','photo','hf','hb','by','createdAt','updatedAt','att'])
    && d.rid is string && d.beneficiary is string && d.beneficiary.size()>0 && d.beneficiary.size()<=120
    && s(d,'relation',40) && s(d,'unified',30) && s(d,'district',40) && s(d,'birthDate',12) && s(d,'attendanceDate',12) && s(d,'benKey',140) && okPh(d) && (!('att' in d) || (d.att is list && d.att.size()<=500))}
  function okImg(d){return d.keys().hasOnly(['rid','d']) && d.d is string && d.d.size()<1000000 && d.d.matches('data:image/jpeg;base64,.*')}
  match /meta/setup { allow read: if true;
    allow create: if sig() && request.resource.data.by==request.auth.uid && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.role=='admin'; }
  match /users/{u} {
    allow read: if has() && (isAdmin() || request.auth.uid==u);
    allow create: if (isAdmin() && request.auth.uid!=u && request.resource.data.role in ['user','editor','admin'])
      || (sig() && request.auth.uid==u && request.resource.data.role=='admin' && !exists(/databases/$(db)/documents/meta/setup));
    allow update: if isAdmin() && request.auth.uid!=u && request.resource.data.role in ['user','editor','admin'];
    allow delete: if isAdmin() && request.auth.uid!=u;
  }
  match /records/{r} {
    allow read: if has();
    allow create: if has() && okRec(request.resource.data) && request.resource.data.by==get(U()).data.name;
    allow update: if (canEdit() && okRec(request.resource.data))
      || (has() && okRec(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bc','sk','ld','att','attendanceDate','updatedAt']));
    allow delete: if isAdmin();
  }
  match /bens/{b} {
    allow read: if has();
    allow create: if has() && okBen(request.resource.data) && request.resource.data.by==get(U()).data.name;
    allow update: if (canEdit() && okBen(request.resource.data))
      || (has() && okBen(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['att','attendanceDate','updatedAt']));
    allow delete: if isAdmin();
  }
  match /images/{i} {
    allow read: if has();
    allow create: if has() && okImg(request.resource.data);
    allow update: if canEdit() && okImg(request.resource.data);
    allow delete: if canEdit();
  }
  match /activity/{a} {
    allow read: if isAdmin();
    allow create: if has() && request.resource.data.keys().hasOnly(['t','u','x','at']) && request.resource.data.t in ['login','add','del','att']
      && request.resource.data.u==get(U()).data.name && request.resource.data.x is string && request.resource.data.x.size()<=200 && request.resource.data.at is number;
    allow update: if false;
    allow delete: if isAdmin();
  }
  match /{any=**} { allow read, write: if false; }
 }
}
